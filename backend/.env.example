# Required for database-backed routes and signup/login.
MONGO_URI=
JWT_SECRET=

# Required for credentialed browser requests in production. Use the exact
# deployed frontend origin, with no trailing slash (for example, https://app.example.com).
FRONTEND_URL=http://localhost:5173

# Required only for profile/post image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set automatically by Vercel in deployments; use these for local development.
NODE_ENV=development
PORT=8000